NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret-at-least-32-chars
# Optional path to the local SQLite database file. Defaults to .data/planner.db
NUXT_DATABASE_URL=
# Hosted libSQL (Turso). Set BOTH to run against Turso instead of a local file —
# required on serverless hosts such as Vercel, where the filesystem is read-only.
#   turso db create <name>
#   turso db show <name> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NUXT_APP_ORIGIN=http://localhost:4000
NUXT_SINGLE_USER_MODE=true
NUXT_DEMO_USER_EMAIL=founder@serene-executive.app
NUXT_DEMO_USER_PASSWORD=ConciergeDemo123!
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Anthropic API key for the AI Assistant chat (create/append entries via Claude)
NUXT_ANTHROPIC_API_KEY=
